{
  "name": "request-level error catalogue",
  "source": "spec §3.8",
  "shape": { "error": { "code": "string", "message": "string", "docs_url": "string", "request_id": "string" } },
  "errors": [
    { "status": 400, "code": "invalid_json", "retry": "no" },
    { "status": 400, "code": "invalid_body", "retry": "no" },
    { "status": 400, "code": "batch_empty", "retry": "no" },
    { "status": 400, "code": "batch_too_many_items", "retry": "no" },
    { "status": 400, "code": "all_items_invalid", "retry": "no", "item_errors": true },
    { "status": 400, "code": "invalid_query", "retry": "no" },
    { "status": 401, "code": "missing_key", "retry": "no" },
    { "status": 401, "code": "invalid_key", "retry": "no" },
    { "status": 403, "code": "browser_not_allowed", "retry": "no" },
    { "status": 404, "code": "not_found", "retry": "no" },
    { "status": 405, "code": "method_not_allowed", "retry": "no" },
    { "status": 410, "code": "api_version_retired", "retry": "no" },
    { "status": 413, "code": "payload_too_large", "retry": "split" },
    { "status": 415, "code": "unsupported_media_type", "retry": "no" },
    { "status": 415, "code": "unsupported_encoding", "retry": "no" },
    { "status": 429, "code": "rate_limited", "retry": "yes", "retry_after": "10" },
    { "status": 500, "code": "internal_error", "retry": "yes" },
    { "status": 503, "code": "collection_unavailable", "retry": "yes", "retry_after": "5" }
  ],
  "item_codes": [
    "invalid_item_type",
    "item_type_not_yet_supported",
    "missing_event_name",
    "invalid_event_name",
    "reserved_event_name",
    "missing_identity",
    "invalid_distinct_id",
    "invalid_anonymous_id",
    "invalid_session_id",
    "invalid_insert_id",
    "duplicate_insert_id",
    "invalid_timestamp",
    "timestamp_too_old",
    "timestamp_in_future",
    "timestamp_before_retention",
    "invalid_properties",
    "properties_too_large",
    "too_many_properties",
    "reserved_property",
    "invalid_reserved_property"
  ]
}
